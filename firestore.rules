rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isPlayer() {
      return isAuth() && request.auth.uid in resource.data.players;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Matches collection
    match /matches/{matchId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && isPlayer();
      allow delete: if false;

      // Answers subcollection
      match /answers/{userId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
    }

    // Questions collection (read-only for authenticated users)
    match /questions/{questionId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Ghost runs collection
    match /ghostRuns/{ghostRunId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // Quiz attempts — analytics tracking
    match /quizAttempts/{attemptId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Question reports — user-submitted bug reports
    match /questionReports/{reportId} {
      allow read: if false;
      allow create: if isAuth()
                     && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Friends & Requests
    match /friends/{friendDocId} {
      allow read, write: if isAuth() && friendDocId.matches('.*' + request.auth.uid + '.*');
    }

    match /friendRequests/{requestId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isAuth() && request.auth.uid == request.resource.data.from;
      allow delete: if isAuth() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }
  }
}
