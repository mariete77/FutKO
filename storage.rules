rules_version = '2';

// FutKO Storage Rules
// Bucket structure:
//   /badges/{teamId}.png     — Team badges/crests
//   /stadiums/{stadiumId}.jpg — Stadium photos
//   /players/{playerId}.jpg  — Player photos
//   /silhouettes/{playerId}.png — Player silhouettes for quiz
//   /competitions/{competitionId}.png — Competition logos
//   /questions/{questionId}/  — Custom question images
//
// Security model:
//   • READ:  Only authenticated users
//   • WRITE: Only server-side (Firebase Admin SDK / Cloud Functions)
//   • No client uploads allowed directly

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny-all, then allow specific paths
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Silhouettes (quiz assets) ─────────────────────────
    match /silhouettes/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /silhouettes/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Badges / Crests ───────────────────────────────────
    match /badges/{teamId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /badges/{teamId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Stadiums ──────────────────────────────────────────
    match /stadiums/{stadiumId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /stadiums/{stadiumId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Players ───────────────────────────────────────────
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /players/{playerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Competitions ──────────────────────────────────────
    match /competitions/{competitionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /competitions/{competitionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Custom question images ────────────────────────────
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /questions/{questionId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
